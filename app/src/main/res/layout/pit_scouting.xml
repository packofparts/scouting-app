<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".PitScouting">
    <TextView
        android:id="@+id/title"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/border"
        android:layout_height="55dp"
        android:layout_width="0dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:text="Pit Scouting"
        android:textStyle="bold"
        android:fontFamily="@font/interextrabold"
        app:autoSizeMaxTextSize="18sp"
        app:autoSizeMinTextSize="1sp"
        app:autoSizeTextType="uniform"
        />
    <ImageButton
        android:id="@+id/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1"
        android:gravity="center"
        android:src="@drawable/backarrow"
        android:textColor="@color/white"
        android:backgroundTint="#00000000"/>

    <TextView
        android:id="@+id/reset"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="1sp"
        android:textColor="#0D59F2"
        app:layout_constraintDimensionRatio="1"
        android:gravity="center"
        android:src="@drawable/backarrow"
        android:backgroundTint="#00000000"/>

    <com.example.myapplication.CustomScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#101622"
        app:layout_constraintBottom_toTopOf="@id/submit_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title">

        <androidx.constraintlayout.widget.ConstraintLayout

            android:id="@+id/relativeLayoutFirst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#101622"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/driveTrainTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="ROBOT MANEUVERABILITY"
                android:textColor="#94A3B8"
                android:textStyle="bold"
                android:fontFamily="@font/interbold"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/driveTrainLayout"
                android:elevation="2dp"
                android:layout_width="0dp"
                android:layout_height="74dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/driveTrainTitle"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:background="@drawable/border_rounded">
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/g1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.25" />
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/g1"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintTop_toTopOf="parent"
                    android:src="@drawable/car"
                    android:id="@+id/car"/>
                <TextView
                    android:id="@+id/driveTrainHeader"
                    android:fontFamily="@font/interbold"
                    app:layout_constraintStart_toEndOf="@id/car"
                    android:layout_marginStart="5dp"
                    app:layout_constraintEnd_toStartOf="@id/driveTrainBackground"
                    app:layout_constraintTop_toTopOf="@id/car"
                    app:layout_constraintBottom_toTopOf="@id/driveTrainExplanation"
                    android:layout_height="24dp"
                    android:layout_width="0dp"
                    android:gravity="start"
                    android:textColor="@color/white"
                    android:text="Drive Train"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeMinTextSize="1sp"
                    app:autoSizeTextType="uniform" />
                <TextView
                    android:id="@+id/driveTrainExplanation"
                    android:fontFamily="@font/interbold"
                    app:layout_constraintStart_toEndOf="@id/car"
                    android:layout_marginStart="5dp"
                    app:layout_constraintEnd_toStartOf="@id/driveTrainBackground"
                    app:layout_constraintTop_toBottomOf="@id/driveTrainHeader"
                    app:layout_constraintBottom_toBottomOf="@id/car"
                    android:layout_height="24dp"
                    android:layout_width="0dp"
                    android:gravity="start"
                    android:textColor="#94A3B8"
                    android:text="How the robot drives"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeMinTextSize="1sp"
                    app:autoSizeTextType="uniform" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/driveTrainBackground"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:background="@drawable/border_rounded"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/driveTrainHeader"
                    app:layout_constraintEnd_toEndOf="parent">

                    <Spinner
                        android:id="@+id/driveTrain"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:fontFamily="@font/interbold"
                        android:backgroundTint="#D9D9D9"
                        android:spinnerMode="dropdown"/>
                </androidx.constraintlayout.widget.ConstraintLayout>




            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/intakeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="GAME PIECE INTERACTION"
                android:textColor="#94A3B8"
                android:textStyle="bold"
                android:fontFamily="@font/interbold"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/driveTrainLayout"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/intakeLayout"
                android:elevation="2dp"
                android:layout_width="0dp"
                android:layout_height="74dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/intakeTitle"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:background="@drawable/border_rounded">
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/g2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.25" />
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/g2"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintTop_toTopOf="parent"
                    android:src="@drawable/shovel"
                    android:id="@+id/shovel"/>
                <TextView
                    android:id="@+id/intakeHeader"
                    android:fontFamily="@font/interbold"
                    app:layout_constraintStart_toEndOf="@id/shovel"
                    android:layout_marginStart="5dp"
                    app:layout_constraintEnd_toStartOf="@id/intakeBackground"
                    app:layout_constraintTop_toTopOf="@id/shovel"
                    app:layout_constraintBottom_toTopOf="@id/intakeExplanation"
                    android:layout_height="24dp"
                    android:layout_width="0dp"
                    android:gravity="start"
                    android:textColor="@color/white"
                    android:text="Intake"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeMinTextSize="1sp"
                    app:autoSizeTextType="uniform" />
                <TextView
                    android:id="@+id/intakeExplanation"
                    android:fontFamily="@font/interbold"
                    app:layout_constraintStart_toEndOf="@id/shovel"
                    android:layout_marginStart="5dp"
                    app:layout_constraintEnd_toStartOf="@id/intakeBackground"
                    app:layout_constraintTop_toBottomOf="@id/intakeHeader"
                    app:layout_constraintBottom_toBottomOf="@id/shovel"
                    android:layout_height="24dp"
                    android:layout_width="0dp"
                    android:gravity="start"
                    android:textColor="#94A3B8"
                    android:text="How the robot gets fuel"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeMinTextSize="1sp"
                    app:autoSizeTextType="uniform" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/intakeBackground"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:background="@drawable/border_rounded"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/intakeHeader"
                    app:layout_constraintEnd_toEndOf="parent">

                    <Spinner
                        android:id="@+id/intake"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:backgroundTint="#D9D9D9"
                        android:fontFamily="@font/interbold"
                        android:spinnerMode="dropdown"
                        android:visibility="visible"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/launcherLayout"
                android:elevation="2dp"
                android:layout_width="0dp"
                android:layout_height="74dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/intakeLayout"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:background="@drawable/border_rounded">
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/g4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.25" />
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/g4"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintTop_toTopOf="parent"
                    android:src="@drawable/launcher"
                    android:id="@+id/launch"/>
                <TextView
                    android:id="@+id/launcherHeader"
                    android:fontFamily="@font/interbold"
                    app:layout_constraintStart_toEndOf="@id/launch"
                    android:layout_marginStart="5dp"
                    app:layout_constraintEnd_toStartOf="@id/launcherBackground"
                    app:layout_constraintTop_toTopOf="@id/launch"
                    app:layout_constraintBottom_toTopOf="@id/launcherExplanation"
                    android:layout_height="24dp"
                    android:layout_width="0dp"
                    android:gravity="start"
                    android:textColor="@color/white"
                    android:text="Launcher Type"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeMinTextSize="1sp"
                    app:autoSizeTextType="uniform" />
                <TextView
                    android:id="@+id/launcherExplanation"
                    android:fontFamily="@font/interbold"
                    app:layout_constraintStart_toEndOf="@id/launch"
                    android:layout_marginStart="5dp"
                    app:layout_constraintEnd_toStartOf="@id/launcherBackground"
                    app:layout_constraintTop_toBottomOf="@id/launcherHeader"
                    app:layout_constraintBottom_toBottomOf="@id/launch"
                    android:layout_height="24dp"
                    android:layout_width="0dp"
                    android:gravity="start"
                    android:textColor="#94A3B8"
                    android:text="How the robot ejects fuel"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeMinTextSize="1sp"
                    app:autoSizeTextType="uniform" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/launcherBackground"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:background="@drawable/border_rounded"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/launcherHeader"
                    app:layout_constraintEnd_toEndOf="parent">

                    <Spinner
                        android:id="@+id/launcher"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:backgroundTint="#D9D9D9"
                        android:fontFamily="@font/interbold"
                        android:spinnerMode="dropdown"
                        android:visibility="visible"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/widthLayout"
                android:elevation="2dp"
                android:layout_width="0dp"
                android:layout_height="74dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/launcherLayout"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:background="@drawable/border_rounded">
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/g5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.25" />
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/g5"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintTop_toTopOf="parent"
                    android:src="@drawable/width"
                    android:id="@+id/wide"/>
                <TextView
                    android:id="@+id/widthHeader"
                    android:fontFamily="@font/interbold"
                    app:layout_constraintStart_toEndOf="@id/wide"
                    android:layout_marginStart="5dp"
                    app:layout_constraintEnd_toStartOf="@id/widthBackground"
                    app:layout_constraintTop_toTopOf="@id/wide"
                    app:layout_constraintBottom_toTopOf="@id/widthExplanation"
                    android:layout_height="24dp"
                    android:layout_width="0dp"
                    android:gravity="start"
                    android:textColor="@color/white"
                    android:text="Launcher Width"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeMinTextSize="1sp"
                    app:autoSizeTextType="uniform" />
                <TextView
                    android:id="@+id/widthExplanation"
                    android:fontFamily="@font/interbold"
                    app:layout_constraintStart_toEndOf="@id/wide"
                    android:layout_marginStart="5dp"
                    app:layout_constraintEnd_toStartOf="@id/widthBackground"
                    app:layout_constraintTop_toBottomOf="@id/widthHeader"
                    app:layout_constraintBottom_toBottomOf="@id/wide"
                    android:layout_height="24dp"
                    android:layout_width="0dp"
                    android:gravity="start"
                    android:textColor="#94A3B8"
                    android:text="Total width of the launcher(s), in fuel"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeMinTextSize="1sp"
                    app:autoSizeTextType="uniform" />

                <EditText
                    android:id="@+id/widthBackground"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:background="@drawable/border_rounded"
                    android:hint="# of fuel"
                    android:maxLines="1"
                    android:inputType="number"
                    android:textColor="#FFFFFF"
                    android:paddingStart="16dp"
                    android:textColorHint="#64748B"
                    android:fontFamily="@font/interbold"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="1sp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/widthHeader"
                    app:layout_constraintEnd_toEndOf="parent">


                </EditText>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:id="@+id/terrainTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="TERRAIN CAPABILITIES"
                android:textColor="#94A3B8"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/widthLayout"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/terrainLayout"
                android:elevation="2dp"
                android:layout_width="0dp"
                android:layout_height="74dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/terrainTitle"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:background="@drawable/border_rounded">
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/g3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.25" />
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/g3"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintTop_toTopOf="parent"
                    android:src="@drawable/mountain"
                    android:id="@+id/mountain"/>
                <TextView
                    android:id="@+id/terrainHeader"
                    android:fontFamily="@font/interbold"
                    app:layout_constraintStart_toEndOf="@id/mountain"
                    android:layout_marginStart="5dp"
                    app:layout_constraintEnd_toStartOf="@id/terrainBackground"
                    app:layout_constraintTop_toTopOf="@id/mountain"
                    app:layout_constraintBottom_toTopOf="@id/terrainExplanation"
                    android:layout_height="24dp"
                    android:layout_width="0dp"
                    android:gravity="start"
                    android:textColor="@color/white"
                    android:text="Terrain"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeMinTextSize="1sp"
                    app:autoSizeTextType="uniform" />
                <TextView
                    android:id="@+id/terrainExplanation"
                    android:fontFamily="@font/interbold"
                    app:layout_constraintStart_toEndOf="@id/mountain"
                    android:layout_marginStart="5dp"
                    app:layout_constraintEnd_toStartOf="@id/terrainBackground"
                    app:layout_constraintTop_toBottomOf="@id/terrainHeader"
                    app:layout_constraintBottom_toBottomOf="@id/mountain"
                    android:layout_height="24dp"
                    android:layout_width="0dp"
                    android:gravity="start"
                    android:textColor="#94A3B8"
                    android:text="How the robot traverses"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeMinTextSize="1sp"
                    app:autoSizeTextType="uniform" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/terrainBackground"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:background="@drawable/border_rounded"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/terrainHeader"
                    app:layout_constraintEnd_toEndOf="parent">

                    <Spinner
                        android:id="@+id/terrain"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:backgroundTint="#D9D9D9"
                        android:spinnerMode="dropdown"
                        android:fontFamily="@font/interbold"
                        android:visibility="visible"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/photoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="PHOTO EVIDENCE"
                android:textColor="#94A3B8"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/terrainLayout"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/photoLayout"
                android:elevation="2dp"
                android:layout_width="0dp"
                android:layout_height="74dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/photoTitle"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:background="@drawable/border_rounded">
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/g6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.25" />
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/g6"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintTop_toTopOf="parent"
                    android:src="@drawable/camera"
                    android:id="@+id/camera"/>
                <TextView
                    android:id="@+id/photoHeader"
                    android:fontFamily="@font/interbold"
                    app:layout_constraintStart_toEndOf="@id/camera"
                    android:layout_marginStart="5dp"
                    app:layout_constraintEnd_toStartOf="@id/photoBackground"
                    app:layout_constraintTop_toTopOf="@id/camera"
                    app:layout_constraintBottom_toTopOf="@id/photoExplanation"
                    android:layout_height="24dp"
                    android:layout_width="0dp"
                    android:gravity="start"
                    android:textColor="@color/white"
                    android:text="Robot Photo"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeMinTextSize="1sp"
                    app:autoSizeTextType="uniform" />
                <TextView
                    android:id="@+id/photoExplanation"
                    android:fontFamily="@font/interbold"
                    app:layout_constraintStart_toEndOf="@id/camera"
                    android:layout_marginStart="5dp"
                    app:layout_constraintEnd_toStartOf="@id/photoBackground"
                    app:layout_constraintTop_toBottomOf="@id/photoHeader"
                    app:layout_constraintBottom_toBottomOf="@id/camera"
                    android:layout_height="24dp"
                    android:layout_width="0dp"
                    android:gravity="start"
                    android:textColor="#94A3B8"
                    android:text="Use camera app to take a photo of the robot!"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeMinTextSize="1sp"
                    app:autoSizeTextType="uniform" />

                <Button
                    android:id="@+id/photoBackground"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#0D59F2"
                    android:text="Select..."
                    android:textColor="#FFFFFF"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeMinTextSize="1sp"
                    app:autoSizeTextType="uniform"
                    android:textStyle="bold"
                    android:fontFamily="@font/interbold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/photoHeader"
                    app:layout_constraintEnd_toEndOf="parent">


                </Button>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/notesTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="PIT SCOUTING NOTES"
                android:textColor="#94A3B8"
                android:textStyle="bold"
                android:fontFamily="@font/interbold"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/photoLayout"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:background="@drawable/border_rounded"
                android:hint="Enter key observations (e.g. reliability , speed, robot status)..."
                android:inputType="textMultiLine"
                android:maxLines="6"
                android:maxLength="150"
                android:tag="@string/no_change"
                android:textColor="#94A3B8"
                android:textColorHint="#94A3B8"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="1sp"
                android:gravity="top|start"
                android:padding="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/notesTitle"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp" />

            <TextView
                android:id="@+id/characterLimit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="CHARACTER LIMIT: 0/150"
                android:textColor="#94A3B8"
                android:textStyle="bold"
                android:fontFamily="@font/interbold"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/input"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.example.myapplication.CustomScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="89dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/border"
        android:id="@+id/submit_area">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cont"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            android:backgroundTint="#0D59F2"
            android:text="Submit Pit Scouting"
            android:textColor="#FFFFFF"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="1sp"
            app:autoSizeTextType="uniform"
            android:textStyle="bold"
            android:fontFamily="@font/interbold"
            app:cornerRadius="12dp"
            app:elevation="6dp"
            app:icon="@drawable/send"
            app:iconGravity="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>