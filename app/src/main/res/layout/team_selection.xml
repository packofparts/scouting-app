<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#0B0F1A"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.myapplication.CustomScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0F1A"
        android:paddingTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="113dp"
                android:layout_height="100dp"
                android:layout_marginTop="0dp"
                android:scaleType="fitXY"
                android:src="@drawable/logo2"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="TEAM SELECTION"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:fontFamily="@font/interextrabold"
                app:layout_constraintTop_toBottomOf="@+id/logoImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Red 1"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:fontFamily="@font/interbold"
                app:layout_constraintTop_toBottomOf="@+id/titleText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/scouterLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="30dp"
                android:text="Scouter Identity"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:fontFamily="@font/interextrabold"
                app:layout_constraintTop_toBottomOf="@+id/subtitleText"
                app:layout_constraintStart_toStartOf="parent" />

            <AutoCompleteTextView
                android:id="@+id/scouterNameInput"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/border_rounded"
                android:hint="Enter scouter name"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:paddingStart="16dp"
                android:textColorHint="#64748B"
                android:fontFamily="@font/interbold"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintTop_toBottomOf="@+id/scouterLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/random"
                app:layout_constraintHorizontal_weight="4"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/random"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/border_rounded"
                android:text="🎲"
                app:autoSizeMaxTextSize="24sp"
                app:autoSizeMinTextSize="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintTop_toBottomOf="@+id/scouterLabel"
                app:layout_constraintStart_toEndOf="@+id/scouterNameInput"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"/>




            <TextView
                android:id="@+id/matchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="27dp"
                android:text="Match No."
                android:textColor="#64748B"
                android:textSize="10sp"
                android:fontFamily="@font/interextrabold"
                app:layout_constraintTop_toBottomOf="@+id/scouterNameInput"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/teamLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="Team No."
                android:textColor="#64748B"
                android:textSize="10sp"
                android:fontFamily="@font/interextrabold"
                app:layout_constraintTop_toBottomOf="@+id/scouterNameInput"
                app:layout_constraintStart_toStartOf="@+id/teamNumberInput"/>

            <EditText
                android:id="@+id/matchInputContainer"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/border_rounded"
                android:hint="Match #"
                android:maxLines="1"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:paddingStart="16dp"
                android:textColorHint="#64748B"
                android:fontFamily="@font/interbold"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintTop_toBottomOf="@+id/matchLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/teamNumberInput"/>



            <EditText
                android:id="@+id/teamNumberInput"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/border_rounded"
                android:hint="Team #"
                android:maxLines="1"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:paddingStart="16dp"
                android:textColorHint="#64748B"
                android:fontFamily="@font/interbold"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintTop_toBottomOf="@+id/teamLabel"
                app:layout_constraintStart_toEndOf="@+id/matchInputContainer"
                app:layout_constraintEnd_toEndOf="parent"/>



            <TextView
                android:id="@+id/scheduleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="32dp"
                android:text="Upcoming Schedule"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:fontFamily="@font/interextrabold"
                app:layout_constraintTop_toBottomOf="@+id/matchInputContainer"
                app:layout_constraintStart_toStartOf="parent" />



            <androidx.cardview.widget.CardView
                android:id="@+id/scheduleCard1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                android:background="#1E293B"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@+id/scheduleLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/boxschedule"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/matchBox1Num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/match_num_bg"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:visibility="gone"/>

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:scrollbars="none"
                        app:layout_constraintTop_toTopOf="@+id/matchBox1Num"
                        app:layout_constraintBottom_toBottomOf="@+id/matchBox1Num"
                        app:layout_constraintStart_toEndOf="@+id/matchBox1Num"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:id="@+id/Match1"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/matchBox1Blue1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/blue_team_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:fontFamily="@font/interbold"
                                android:textColor="#9E3338"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox1Blue2"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/blue_team_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:fontFamily="@font/interbold"
                                android:textColor="#9E3338"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox1Blue3"

                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/blue_team_bg"
                                android:fontFamily="@font/interbold"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:textColor="#9E3338"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox1Red1"

                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/red_team_bg"
                                android:fontFamily="@font/interbold"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:textColor="#2563EB"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox1Red2"

                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/red_team_bg"
                                android:fontFamily="@font/interbold"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:textColor="#2563EB"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox1Red3"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/red_team_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:fontFamily="@font/interbold"
                                android:textColor="#2563EB"
                                android:textSize="11sp" />

                        </LinearLayout>
                    </HorizontalScrollView>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/scheduleCard2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                android:background="#1E293B"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@+id/scheduleCard1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/boxschedule"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/matchBox2Num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/match_num_bg"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:visibility="gone"/>

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:scrollbars="none"
                        app:layout_constraintTop_toTopOf="@+id/matchBox2Num"
                        app:layout_constraintBottom_toBottomOf="@+id/matchBox2Num"
                        app:layout_constraintStart_toEndOf="@+id/matchBox2Num"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:id="@+id/Match2"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/matchBox2Blue1"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/gray_team_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:fontFamily="@font/interbold"
                                android:textColor="#6B7789"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox2Blue2"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/gray_team_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:fontFamily="@font/interbold"
                                android:textColor="#6B7789"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox2Blue3"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/gray_team_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:fontFamily="@font/interbold"
                                android:textColor="#6B7789"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox2Red1"

                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/gray_team_bg"
                                android:fontFamily="@font/interbold"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:textColor="#6B7789"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox2Red2"

                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/gray_team_bg"
                                android:fontFamily="@font/interbold"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:textColor="#6B7789"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox2Red3"

                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/gray_team_bg"
                                android:fontFamily="@font/interbold"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:textColor="#6B7789"
                                android:textSize="11sp" />

                        </LinearLayout>
                    </HorizontalScrollView>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/scheduleCard3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                android:background="#1E293B"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@+id/scheduleCard2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/boxschedule"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/matchBox3Num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/match_num_bg"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:visibility="gone"/>

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:scrollbars="none"
                        app:layout_constraintTop_toTopOf="@+id/matchBox3Num"
                        app:layout_constraintBottom_toBottomOf="@+id/matchBox3Num"
                        app:layout_constraintStart_toEndOf="@+id/matchBox3Num"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:id="@+id/Match3"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/matchBox3Blue1"

                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:background="@drawable/gray_team_bg"
                                android:fontFamily="@font/interbold"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:textColor="#6B7789"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox3Blue2"

                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/gray_team_bg"
                                android:fontFamily="@font/interbold"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:textColor="#6B7789"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox3Blue3"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/gray_team_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:fontFamily="@font/interbold"
                                android:textColor="#6B7789"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox3Red1"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/gray_team_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:fontFamily="@font/interbold"
                                android:textColor="#6B7789"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox3Red2"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/gray_team_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:fontFamily="@font/interbold"
                                android:textColor="#6B7789"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/matchBox3Red3"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/gray_team_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:fontFamily="@font/interbold"
                                android:textColor="#6B7789"
                                android:textSize="11sp" />

                        </LinearLayout>
                    </HorizontalScrollView>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startScoutingButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="24dp"
                android:backgroundTint="#0D59F2"
                android:text="Start Match Scouting"
                android:textColor="#FFFFFF"
                app:autoSizeMaxTextSize="20sp"
                app:autoSizeMinTextSize="1sp"
                app:autoSizeTextType="uniform"
                android:textStyle="bold"
                android:elevation="12dp"
                android:stateListAnimator="@null"
                app:cornerRadius="12dp"
                app:icon="@drawable/send"
                app:iconGravity="end"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/scheduleCard3" />

            <Button
                android:id="@+id/pitScoutingButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="24dp"
                android:backgroundTint="#131927"
                android:text="Go to Pit Scouting"
                android:textColor="#FFFFFF"
                app:autoSizeMaxTextSize="20sp"
                app:autoSizeMinTextSize="1sp"
                app:autoSizeTextType="uniform"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/backarrow"
                app:iconGravity="start"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/startScoutingButton" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.example.myapplication.CustomScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>